<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Energie4You.MainPage"
             Title="Energie4You">

    <Grid Padding="15"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="10">

        <Label Grid.Row="0"
               Text="Energie4You"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#512BD4"
               HorizontalOptions="Center"/>

        <ScrollView Grid.Row="1">
            <Grid x:Name="FormulierGrid"
                  ColumnDefinitions="*"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="15"
                  ColumnSpacing="25">

                <VerticalStackLayout x:Name="GegevensKolom"
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     Spacing="10">

                    <Label Text="Nieuwe defectmelding"
                           FontSize="20"
                           FontAttributes="Bold"/>

                    <Label Text="Naam monteur"/>
                    <Entry x:Name="MonteurEntry"
                           Placeholder="Vul je naam in"/>

                    <Label Text="Categorie"/>
                    <Picker x:Name="CategoriePicker"
                            Title="Selecteer een categorie">
                        <Picker.Items>
                            <x:String>Grondkabels</x:String>
                            <x:String>Luchtkabels</x:String>
                            <x:String>Hoogspanningsmasten</x:String>
                            <x:String>Schakelkasten</x:String>
                        </Picker.Items>
                    </Picker>

                    <Label Text="Omschrijving defect"/>
                    <Editor x:Name="OmschrijvingEditor"
                            Placeholder="Beschrijf het defect"
                            HeightRequest="100"/>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="FotoGpsKolom"
                                     Grid.Row="1"
                                     Grid.Column="0"
                                     Spacing="10">

                    <Label Text="Locatie van het defect"/>

                    <Button Text="GPS-locatie ophalen"
                            BackgroundColor="#247BA0"
                            TextColor="White"
                            Clicked="OnGpsClicked"/>

                    <Label x:Name="LocatieLabel"
                           Text="Nog geen locatie opgehaald"
                           FontSize="14"
                           TextColor="Gray"/>

                    <Label Text="Foto van het defect"/>

                    <Button Text="Foto maken"
                            BackgroundColor="#247BA0"
                            TextColor="White"
                            Clicked="OnFotoMakenClicked"/>

                    <Image x:Name="FotoPreview"
                           HeightRequest="150"
                           Aspect="AspectFit"
                           IsVisible="False"/>

                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">

            <Button Grid.Column="0"
                    Text="Melding opslaan"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    Clicked="OnOpslaanClicked"/>

            <Button x:Name="EmailButton"
                    Grid.Column="1"
                    Text="Melding e-mailen"
                    BackgroundColor="#247BA0"
                    TextColor="White"
                    IsEnabled="False"
                    Clicked="OnEmailClicked"/>

        </Grid>

    </Grid>
</ContentPage>
